# Ludo Legends - server environment template
#
# Copy to .env (never commit it) or set these as environment variables in your host's
# dashboard. Double underscores map to configuration sections in ASP.NET Core.
#
#   Ludo:Database:Provider  ->  LUDO__DATABASE__PROVIDER
#
# Anything marked REQUIRED makes the server refuse to start (in Production) when missing,
# on purpose: a game server with a default signing key is a game server anyone can forge
# sessions for.

# ---------------------------------------------------------------- required
# 32+ random characters. Generate with:  openssl rand -base64 48
LUDO__TOKENSIGNINGKEY=

# ---------------------------------------------------------------- database
# "postgres" in production, "sqlite" for local development.
LUDO__DATABASE__PROVIDER=postgres
# PostgreSQL connection string from Neon / Supabase / your own instance.
# Example: Host=ep-xxx.eu-central-1.aws.neon.tech;Database=ludo;Username=ludo;Password=...;SSL Mode=Require
LUDO__DATABASE__CONNECTIONSTRING=
# false in production: apply db/postgres-schema.sql (or generated DDL) yourself.
LUDO__DATABASE__AUTOCREATE=false

# ---------------------------------------------------------------- public origin
LUDO__PUBLICBASEURL=https://ludo.example.com

# ---------------------------------------------------------------- google sign-in (optional)
# OAuth *web* client id. Guest login works without it.
LUDO__GOOGLECLIENTID=

# ---------------------------------------------------------------- gameplay
LUDO__GAME__TURNTIMEOUTSECONDS=25
LUDO__GAME__DISCONNECTGRACESECONDS=60
LUDO__GAME__ROOMIDLETIMEOUTMINUTES=10
LUDO__GAME__MESSAGESPERSECOND=8

# ---------------------------------------------------------------- voice (optional)
# Separate HMAC key for voice tokens; falls back to the session key when empty.
LUDO__VOICE__TOKENSIGNINGKEY=
LUDO__VOICE__PROVIDER=photon
LUDO__VOICE__PHOTONAPPID=
LUDO__VOICE__TOKENLIFETIMESECONDS=300

# ---------------------------------------------------------------- push (optional)
# Firebase service-account JSON path on the server. Push notifications are only sent when
# this is configured; the server never ships a Firebase key inside the app.
LUDO__PUSH__SERVICEACCOUNTPATH=
LUDO__PUSH__PROJECTID=

# ---------------------------------------------------------------- economy
LUDO__ECONOMY__STARTINGCOINS=500
LUDO__ECONOMY__XPPerGAME=20
LUDO__ECONOMY__XPPERWIN=60
LUDO__ECONOMY__TROPHIESPERWIN=25
LUDO__ECONOMY__TROPHIESPERLOSS=15

# ---------------------------------------------------------------- hosting
# Bind inside the container; put a TLS-terminating reverse proxy in front.
ASPNETCORE_URLS=http://0.0.0.0:5080
ASPNETCORE_ENVIRONMENT=Production
