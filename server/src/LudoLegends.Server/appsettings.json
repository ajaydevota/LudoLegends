{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ludo": {
    "PublicBaseUrl": "http://localhost:5080",
    "Issuer": "ludolegends",
    "TokenSigningKey": "",
    "TokenLifetimeDays": 30,
    "GoogleClientId": "",
    "Database": {
      "Provider": "sqlite",
      "ConnectionString": "Data Source=ludolegends.db",
      "AutoCreate": true
    },
    "Game": {
      "TurnTimeoutSeconds": 25,
      "DisconnectGraceSeconds": 60,
      "RoomIdleTimeoutMinutes": 10,
      "MaxMessageBytes": 4096,
      "MessagesPerSecond": 8
    },
    "Matchmaking": {
      "BotFillAfterSeconds": 0,
      "QueueTimeoutSeconds": 60
    },
    "Voice": {
      "Provider": "photon",
      "PhotonAppId": "",
      "TokenSigningKey": "",
      "TokenLifetimeSeconds": 300
    },
    "Push": {
      "ServiceAccountPath": "",
      "ProjectId": ""
    },
    "Economy": {
      "StartingCoins": 500,
      "DailyRewards": [ 50, 75, 100, 125, 150, 200, 300 ],
      "XpPerGame": 20,
      "XpPerWin": 60,
      "XpPerLevel": 200,
      "TrophiesPerWin": 25,
      "TrophiesPerLoss": 15
    }
  }
}
